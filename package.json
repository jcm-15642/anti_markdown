{
  "name": "anti-markdown",
  "displayName": "Anti Markdown",
  "description": "Anti Markdown - Modern Markdown live editor, AI diff review, and rich renderer with Mermaid diagrams, KaTeX math, GitHub alerts, Carousels, and universal selection AI capsule for VS Code / Antigravity IDE.",
  "version": "1.7.7",
  "publisher": "mazhao",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "antigravity",
    "markdown",
    "artifact",
    "mermaid",
    "preview",
    "katex",
    "carousel"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:markdown",
    "onCustomEditor:antiMarkdown.artifactEditor",
    "onCommand:antiMarkdown.openNativeArtifact",
    "onCommand:antiMarkdown.openNativeArtifactToSide",
    "onCommand:antiMarkdown.openStandaloneViewer",
    "onCommand:antiMarkdown.openPreviewToSide",
    "onCommand:antiMarkdown.switchEditor",
    "onCommand:antiMarkdown.toggleDefaultAssociation"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "antiMarkdown.artifactEditor",
        "displayName": "Anti Markdown Editor (Pro)",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "**/*.md"
          },
          {
            "filenamePattern": "**/*.markdown"
          },
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "antiMarkdown.openNativeArtifact",
        "title": "使用 Antigravity 原生内置编辑器打开 (Open in Native Artifact Viewer)",
        "category": "Anti Markdown",
        "icon": "$(sparkle)"
      },
      {
        "command": "antiMarkdown.openNativeArtifactToSide",
        "title": "侧边栏打开 Antigravity 原生内置预览 (Open Native Artifact Viewer to the Side)",
        "category": "Anti Markdown",
        "icon": "$(open-preview)"
      },
      {
        "command": "antiMarkdown.openStandaloneViewer",
        "title": "使用 Antigravity 增强型编辑器打开 (Open in Antigravity Artifact Viewer Pro)",
        "category": "Anti Markdown",
        "icon": "$(book)"
      },
      {
        "command": "antiMarkdown.openPreviewToSide",
        "title": "侧边栏打开 Antigravity 实时同步预览 (Open Live Artifact Preview to the Side)",
        "category": "Anti Markdown",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "antiMarkdown.switchEditor",
        "title": "切换 Markdown 源码 / Antigravity 预览 (Switch Source / Artifact Viewer)",
        "category": "Anti Markdown",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "antiMarkdown.toggleDefaultAssociation",
        "title": "配置默认 Markdown 编辑器模式 (Configure Default Markdown Editor)",
        "category": "Anti Markdown",
        "icon": "$(settings-gear)"
      },
      {
        "command": "antiMarkdown.sendSelectionTo.vscode",
        "title": "发送选中内容到 VS Code Chat (Send Selection to VS Code Chat)",
        "category": "Antigravity AI",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "antiMarkdown.sendSelectionTo.antigravity",
        "title": "发送选中内容到 Antigravity (Send Selection to Antigravity)",
        "category": "Antigravity AI",
        "icon": "$(sparkle)"
      },
      {
        "command": "antiMarkdown.sendSelectionTo.claude",
        "title": "发送选中内容到 Claude Code (Send Selection to Claude Code)",
        "category": "Antigravity AI",
        "icon": "$(star-full)"
      },
      {
        "command": "antiMarkdown.sendSelectionTo.codex",
        "title": "发送选中内容到 Codex (Send Selection to Codex)",
        "category": "Antigravity AI",
        "icon": "$(circle-large-outline)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "antiMarkdown.openNativeArtifactToSide",
          "when": "editorLangId == markdown || resourceExtname == '.md' || resourceExtname == '.markdown' || activeCustomEditorId == 'antiMarkdown.artifactEditor' || activeCustomEditorId == 'antigravity.artifactEditor'",
          "group": "navigation@-1"
        },
        {
          "command": "antiMarkdown.openPreviewToSide",
          "when": "editorLangId == markdown || resourceExtname == '.md' || resourceExtname == '.markdown' || activeCustomEditorId == 'antiMarkdown.artifactEditor' || activeCustomEditorId == 'antigravity.artifactEditor'",
          "group": "navigation@-2"
        },
        {
          "command": "antiMarkdown.switchEditor",
          "when": "editorLangId == markdown || resourceExtname == '.md' || resourceExtname == '.markdown' || activeCustomEditorId == 'antiMarkdown.artifactEditor' || activeCustomEditorId == 'antigravity.artifactEditor'",
          "group": "navigation@-3"
        }
      ],
      "explorer/context": [
        {
          "command": "antiMarkdown.openNativeArtifact",
          "when": "resourceExtname == '.md' || resourceExtname == '.markdown'",
          "group": "navigation@1"
        },
        {
          "command": "antiMarkdown.openNativeArtifactToSide",
          "when": "resourceExtname == '.md' || resourceExtname == '.markdown'",
          "group": "navigation@2"
        },
        {
          "command": "antiMarkdown.openStandaloneViewer",
          "when": "resourceExtname == '.md' || resourceExtname == '.markdown'",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "antiMarkdown.openNativeArtifactToSide",
          "when": "editorLangId == markdown",
          "group": "navigation@1"
        },
        {
          "command": "antiMarkdown.openPreviewToSide",
          "when": "editorLangId == markdown",
          "group": "navigation@2"
        },
        {
          "command": "antiMarkdown.switchEditor",
          "when": "editorLangId == markdown",
          "group": "navigation@3"
        },
        {
          "command": "antiMarkdown.sendSelectionTo.vscode",
          "when": "editorHasSelection && antiMarkdown.ai.vscode",
          "group": "0_antiAi@1"
        },
        {
          "command": "antiMarkdown.sendSelectionTo.antigravity",
          "when": "editorHasSelection && antiMarkdown.ai.antigravity",
          "group": "0_antiAi@2"
        },
        {
          "command": "antiMarkdown.sendSelectionTo.claude",
          "when": "editorHasSelection && antiMarkdown.ai.claude",
          "group": "0_antiAi@3"
        },
        {
          "command": "antiMarkdown.sendSelectionTo.codex",
          "when": "editorHasSelection && antiMarkdown.ai.codex",
          "group": "0_antiAi@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "antiMarkdown.switchEditor",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorLangId == markdown || resourceExtname == '.md' || resourceExtname == '.markdown'"
      },
      {
        "command": "antiMarkdown.openNativeArtifactToSide",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorLangId == markdown || resourceExtname == '.md' || resourceExtname == '.markdown'"
      }
    ],
    "configurationDefaults": {
      "editor.hover.above": false
    },
    "configuration": {
      "type": "object",
      "title": "Anti Markdown",
      "properties": {
        "antiMarkdown.engineMode": {
          "type": "string",
          "enum": [
            "standalone",
            "native"
          ],
          "enumDescriptions": [
            "Use the built-in Anti Markdown Editor (supports in-place live editing, TOC outline, Mermaid, Alerts, Carousels, KaTeX, file:// pills, and one-click switch to native viewer).",
            "Automatically delegate *.md custom editor tabs to Antigravity IDE's native internal antigravity.artifactEditor."
          ],
          "default": "standalone",
          "description": "Select which engine powers the Anti Markdown custom editor."
        },
        "antiMarkdown.showOutline": {
          "type": "boolean",
          "default": true,
          "description": "Show the collapsible Table of Contents (TOC) outline sidebar by default."
        },
        "antiMarkdown.previewAiPlatforms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "vscode",
              "antigravity",
              "claude",
              "codex"
            ]
          },
          "default": [
            "vscode",
            "antigravity",
            "claude",
            "codex"
          ],
          "description": "预览渲染窗口中启用的 AI 平台列表 (AI platforms enabled in Markdown preview window)."
        },
        "antiMarkdown.otherFilesCapsuleEnabled": {
          "type": "boolean",
          "default": true,
          "description": "其他代码等普通文件中是否开启选中文本悬浮胶囊 (Enable floating AI selection capsule for code and other files)."
        },
        "antiMarkdown.otherFilesAiPlatforms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "vscode",
              "antigravity",
              "claude",
              "codex"
            ]
          },
          "default": [
            "vscode",
            "antigravity",
            "claude",
            "codex"
          ],
          "description": "其他代码等普通文件的悬浮胶囊中启用的 AI 平台列表 (AI platforms enabled in other files' selection capsule)."
        },
        "antiMarkdown.enabledAiPlatforms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "vscode",
              "antigravity",
              "claude",
              "codex"
            ]
          },
          "default": [
            "vscode",
            "antigravity",
            "claude",
            "codex"
          ],
          "description": "Legacy fallback: Enabled AI chat platforms."
        },
        "antiMarkdown.selectionHoverCapsule": {
          "type": "boolean",
          "default": true,
          "description": "Show the floating AI capsule (Hover: VS Code / Antigravity / Claude Code / Codex) over the current selection in any file."
        },
        "antiMarkdown.showDiffReview": {
          "type": "boolean",
          "default": true,
          "description": "Show inline diff review banners (✓ Accept | ✕ Reject | +X lines, -Y lines) and green additions highlight when files have AI edits or git modifications."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check out/extension.js && node --check media/agy-mermaid.js && node --check media/viewer.js",
    "test": "node test/verify.js",
    "build": "node test/verify.js --bump"
  }
}
